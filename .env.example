# The Fork — environment variables reference
# Copy this file to .env and fill in real values for your environment.
# Master copies of all keys live in the password-manager vault (Bitwarden/1Password);
# Render / GitHub / Cloudflare get copies only. The repo never contains real keys.
#
# Three profiles are noted below for each variable:
#   - REQUIRED-PROD  : production deploy refuses to start without it (or
#                      degrades silently in a way you don't want)
#   - RECOMMENDED    : safe defaults exist but you should set explicitly
#   - OPTIONAL       : feature flags / overrides
#
# Production guard: app/main.py::_validate_startup_env hard-fails the
# process at boot if ENV=production and SECRET_KEY, DATABASE_URL, or
# DATA_ENCRYPTION_KEY is unset. Construction kit flags are also required
# in production.

# ===============================
# Security (REQUIRED-PROD)
# ===============================

# JWT signing secret. Required for production. Tokens are invalidated
# whenever this value changes, so generate ONCE and store somewhere
# durable (env var on the host, secret manager — not the volume only).
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Fernet key for encryption-at-rest of uploaded documents. REQUIRED in
# production — the startup guard refuses to boot without it (plaintext
# uploads would be a confidentiality break for any client corpus).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=

# Master key for admin auth + the /v1/admin/* endpoints (CEREBRUM_MASTER_KEY
# is the legacy name still read by the auth layer). Treat as a root secret.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
CEREBRUM_MASTER_KEY=

# Extra CORS origins (comma-separated, no spaces) merged with the localhost
# defaults in app/main.py. Leave empty to use only the built-in localhost
# origins. Production: list your real frontend origins explicitly.
CORS_EXTRA_ORIGINS=

# ===============================
# Persistence (REQUIRED-PROD)
# ===============================

# Unified SQLAlchemy database. When unset, ALL stores fall back to
# sqlite:///{DATA_DIR}/the_fork.db — fine for local dev, NEVER for prod.
# Production pilot: provision Postgres 16 + pgvector and run
# `alembic upgrade head` before first boot.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/thefork

# Directory for uploaded files, .secret_key fallback, audit.log,
# vector store fallback, learning state, OAuth refresh tokens, and
# every other file-backed artifact. Treat as a precious volume —
# disk loss without backup = permanent loss of the client corpus.
# See docs/backup-and-recovery.md for the snapshot + recovery procedure.
DATA_DIR=./data

# Shared cache + cross-worker session store + rate-limit budget. When
# unset, sessions / rate limits are per-process — fine for
# UVICORN_WORKERS=1, broken for any horizontal scaling. Required if you
# bump UVICORN_WORKERS > 1 or add a second instance.
REDIS_URL=redis://USER:PASSWORD@HOST:6379/0

# Does a background arq worker actually DRAIN the document-ingest queue?
# Leave UNSET unless a worker service is deployed and running.
#
# This is not a performance knob — it decides whether uploads get indexed at
# all. Unset, /v1/upload indexes inline (slower request, document searchable
# when it returns). Set to true WITHOUT a live worker and every upload is
# enqueued to a queue nobody serves: HTTP 200, indexing_status "queued", and
# chunk_count 0 forever, with chat replying "I could not confirm this
# reference in the indexed project sources".
#
# That exact outage ran from 2026-08-08 to 2026-08-14, because the code
# inferred "a worker exists" from REDIS_URL being set — but Redis is shared
# with sessions and rate limiting, so it was set with no worker anywhere.
INGEST_WORKER_ENABLED=

# Transactional email (signup address verification). BOTH are required before
# open registration is safe: with ALLOW_OPEN_REGISTRATION on and these unset,
# /v1/users/register fails closed with 503 rather than mint accounts that can
# never be verified and can never log in.
# EMAIL_FROM's domain must be VERIFIED in Resend or every send 4xxs.
RESEND_API_KEY=
EMAIL_FROM=The Shovel <noreply@theshovel.ai>

# ===============================
# Bootstrap admin (REQUIRED-PROD on first boot only)
# ===============================
# Idempotent: app.main creates this user once at startup if no admin
# exists. After first boot you can rotate the password and leave the
# env unset (the existing admin row in the DB is what matters).
BOOTSTRAP_USER_EMAIL=
BOOTSTRAP_USER_PASSWORD=

# ===============================
# Observability (RECOMMENDED)
# ===============================

# Sentry DSN — when set, unhandled exceptions and 5xx responses are
# reported. Without it the platform is dark on errors past the local
# /v1/metrics (in-memory, resets every restart, per-worker).
SENTRY_DSN=

# ===============================
# Block registry boot profile
# ===============================
# CEREBRUM_VIRGIN=true   loads ~17 generic blocks only (minimal Fork).
# CEREBRUM_VIRGIN=false  loads extended platform blocks (drives, MCP, etc.).
# CEREBRUM_DOMAIN_KITS=construction loads the construction kit.
# Production Fork: CEREBRUM_VIRGIN=false AND CEREBRUM_DOMAIN_KITS=construction.
CEREBRUM_VIRGIN=false
CEREBRUM_DOMAIN_KITS=construction

# ===============================
# AI provider keys — the cloud ladder is exactly TWO providers
# ===============================
# DECISIONS.md 2026-07-24 (operator, final):
#   LLM_PROVIDER=kimi          PRIMARY  — Kimi K2 on Moonshot's native API
#   LLM_FALLBACK_PROVIDER=groq FALLBACK — Groq free tier (the one fallback)
# Ollama is the ON-PREM provider only (deploy/onprem), never a cloud fallback.
LLM_PROVIDER=kimi
LLM_FALLBACK_PROVIDER=groq

# Optional: pin intent classification to a LIGHTER model the PRIMARY provider
# can serve. Leave unset to use KIMI_MODEL / GROQ_MODEL. Do NOT set an
# Ollama id (gpt-oss:20b-cloud, glm-5.2:cloud) while LLM_PROVIDER=kimi —
# Moonshot 400s it and schedule predefined-routing silently never fires.
# ORCHESTRATOR_INTENT_MODEL=

# Kimi (Moonshot) — PRIMARY. Native API at https://api.moonshot.ai/v1.
KIMI_API_KEY=
KIMI_MODEL=kimi-k2.6

# Groq — the single free-tier fallback. Get key from https://console.groq.com
# NOTE: the free/on-demand account 413s payloads >~12k tokens across every
# model it exposes (scout is NOT on the account). It catches normal-size
# turns; large grounded turns need a Groq Dev-tier upgrade (billing gate).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama — ON-PREM provider only (air-gapped fork-in-a-box uses local Ollama).
# Not used on cloud. See deploy/onprem/onprem.env.example.
OLLAMA_API_KEY=
OLLAMA_MODEL=glm-5.2:cloud
OLLAMA_URL=https://ollama.com/v1/chat/completions

# ===============================
# Deployment
# ===============================

# `production` flips the startup guard ON (hard-fails missing SECRET_KEY,
# DATABASE_URL, DATA_ENCRYPTION_KEY, and the construction kit pin).
# `development` skips the guard and accepts more permissive defaults.
# Match this to the environment you're actually running.
ENV=development

# HTTP port the FastAPI app binds. Render sets this for you.
PORT=8000

# Public base URL used to construct generated file links in responses.
# Local: the loopback origin. Production: PUBLIC_BASE_URL=https://theshovel.ai
# (export footers and email-verify links). API_BASE_URL is the older alias
# some scripts still read.
API_BASE_URL=http://localhost:8000
PUBLIC_BASE_URL=http://localhost:8000

# Max upload size in bytes. Code default is 50 MB (drawing sets / BIM).
# Do not copy a 10 MB cap into production — that rejects real project files.
MAX_UPLOAD_SIZE=52428800
MAX_DOC_UPLOAD_SIZE=52428800

# ===============================
# Operations / CLI keys (not used by the running app, needed locally)
# ===============================
# Render API key — used by scripts that read/update prod env vars and deploys.
RENDER_API_KEY=

# Fork CLI credentials. FORK_API_KEY is the CEREBRUM_MASTER_KEY; alternative:
# FORK_EMAIL + FORK_PASSWORD, or FORK_TOKEN.
FORK_API_KEY=
FORK_EMAIL=
FORK_PASSWORD=
FORK_TOKEN=

# ===============================
# Google Drive integration
# ===============================
# Service-account JSON for Drive imports. Paste the full JSON object on one line
# or set via Render env var. Required for scripts/inspect_drive_projects.py --discover
# and the Drive ingestion pipeline.
GDRIVE_SERVICE_ACCOUNT_JSON=

# OAuth credentials for the Drive user-consent flow (frontend "Connect Drive").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://the-fork-jn3t.onrender.com/v1/drive/callback

# Google API key for non-authenticated Drive calls (listing public sheets, etc.).
GOOGLE_API_KEY=

# Map platform project_id → Drive folder_id for controlled re-imports.
# Format: project_id:folder_id,project_id:folder_id
GDRIVE_PROJECT_FOLDERS=

# ===============================
# RAG GK-contamination knobs
# ===============================
# Default off. Turn on only after the Step-2 acceptance battery passes.
RAG_GK_LEXICAL_FOLD=0
RAG_GK_SCORE_MARGIN=0.15
RAG_OWN_DOC_BOOST=0.1
RAG_GK_TOPK_CAP=2

# General-knowledge project identity. After the drive_archive migration the GK
# corpus lives in project `training_material`; `curated_kb` exists but is empty.
RAG_GENERAL_KNOWLEDGE_PROJECTS=training_material

# ===============================
# Second-stage reranker (cross-encoder)
# ===============================
# Default OFF (flag off = pre-reranker pipeline byte-for-byte). Collects a
# deeper candidate pool and lets a cross-encoder pick the top-k.
#
# DO NOT ENABLE with the default model: measured NEGATIVE on drive_archive
# (2026-08-02, doc-recall@5 47% -> 43% — ms-marco web-passage training
# transfers badly to construction chunks). The hook ships dormant so a
# DOMAIN-suitable model can be trialled later by env change alone — offline
# proof first via scripts/rerank_offline_proof.py, full verdict + enable
# checklist in docs/rag-reranker.md. Any model failure degrades to cosine
# order; the model (~90MB) lazy-loads into HF_HOME on first use.
RAG_RERANKER=0
# RAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# RAG_RERANK_CANDIDATES=30

# ===============================
# Process model
# ===============================
# UVICORN_WORKERS is the ONLY knob for uvicorn --workers (default 1).
# Render starter (512Mi): keep at 1; model2vec OOMs with 2 workers.
# Bumping above 1 REQUIRES REDIS_URL (cross-worker session + rate-limit
# state) AND a leader lock on hydration_scheduler — see audit P1.4.
UVICORN_WORKERS=1

# Session TTL applied to both in-memory and Redis session stores
# (default 14400 = 4 hours).
SESSION_TTL_SECONDS=14400

# Global per-identity request cap per 60s sliding window (default 300).
# Set to 0 to disable. JWT user id, API key hash, or client IP is the identity.
RATE_LIMIT_PER_MINUTE=300

# ===============================
# Chat streaming
# ===============================
# Wall-clock cap on agent chat_stream — server emits a structured timeout
# error if the stream is still running after this many seconds.
# 240s is required for Kimi K2 reasoning bursts (90s cut them off).
CHAT_STREAM_TIMEOUT_SECONDS=240

# Heartbeat interval: server pushes {"type": "heartbeat"} after this many
# seconds of silence so frontend reader-deadlines can distinguish a slow
# LLM from a dead connection. Must be less than CHAT_STREAM_TIMEOUT_SECONDS.
CHAT_STREAM_HEARTBEAT_SECONDS=15

# ===============================
# Evidence vault + learning engine
# ===============================
# DO NOT default these to /tmp on Render — /tmp is wiped on restart,
# which silently loses the evidence trail and learning state. Point
# both under DATA_DIR so they ride on the snapshotted volume.
EVIDENCE_VAULT_PATH=./data/evidence_vault.json
LEARNING_ENGINE_STORAGE=./data/learning_engine.json

# ===============================
# RAG embeddings (retrieval)
# ===============================
# Slim Render image: leave unset (defaults to model2vec minishlab/potion-base-8M,
# 256-dim — matches Postgres vector(256)). Do NOT set sentence-transformers unless
# you also migrate chunks.embedding to vector(384).
# RAG_EMBEDDING_MODEL=minishlab/potion-base-8M
# Tests / CI: RAG_EMBEDDING_MODEL=fake

# ===============================
# OCR
# ===============================
# Tesseract language code(s). Default 'eng'. Set to 'ara+eng' for projects
# with Arabic content (e.g. KSA tender BOQs) — requires tesseract-ocr-ara
# in the Docker image.
RAG_OCR_LANG=eng


